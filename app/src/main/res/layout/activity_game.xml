<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity"
    android:background="@drawable/gamebag">

    <ImageButton
        android:id="@+id/targetbtn"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginEnd="172dp"
        android:layout_marginBottom="248dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/target" />

    <TextView
        android:id="@+id/Timer_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="56dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:textColor="#DCE2E8"
        android:shadowRadius="4"
        android:text="Time left:"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/Timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textColor="#DCE2E8"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/Timer_txt"
        app:layout_constraintStart_toEndOf="@+id/Timer_txt"
        app:layout_constraintTop_toTopOf="@+id/Timer_txt" />

    <TextView
        android:id="@+id/score_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Score:"
        android:textColor="#DCE2E8"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Timer_txt" />

    <TextView
        android:id="@+id/scorecounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0"
        android:textColor="#DCE2E8"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/score_tv"
        app:layout_constraintStart_toEndOf="@+id/score_tv"
        app:layout_constraintTop_toTopOf="@+id/score_tv" />


</androidx.constraintlayout.widget.ConstraintLayout>