<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100"
    android:background="@drawable/table2"
    tools:context=".ScoreboardActivity">
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15" />

    <TextView
        android:id="@+id/LeaderBoard_tv"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:fontFamily="@font/abril_fatface"
        android:gravity="center"
        android:text="LeaderBoard"
        android:textColor="#DCE2E8"
        android:textSize="44sp"
        android:textStyle="italic" />
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="44dp">


        <TextView
            android:id="@+id/current_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/acme"
            android:text="current Score:"
            android:textColor="#DCE2E8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/current_score_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:fontFamily="@font/abril_fatface"
            android:textColor="#DCE2E8"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10" />


<TextView
    android:id="@+id/Top3_tv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/abril_fatface"
    android:gravity="center"
    android:text="Global Top 3"
    android:textColor="#DCE2E8"
    android:textSize="30sp"
    android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="44dp">

        <TextView
            android:id="@+id/first_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/acme"
            android:text="1st best Score:"
            android:textColor="#DCE2E8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/first_score_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:fontFamily="@font/acme"
            android:textColor="#DCE2E8"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="44dp">

        <TextView
            android:id="@+id/second_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/acme"
            android:text="2nd best Score:"
            android:textColor="#DCE2E8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/second_score_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:fontFamily="@font/acme"
            android:textColor="#DCE2E8"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingLeft="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/third_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/acme"
            android:text="3rd best Score:"
            android:textColor="#DCE2E8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/third_score_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:fontFamily="@font/acme"
            android:textColor="#DCE2E8"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="44dp">

        <TextView
            android:id="@+id/personal_best_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/acme"
            android:text="Your Best Score: "
            android:textColor="#DCE2E8"
            android:textSize="20sp" />
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15" />

    <Button
        android:id="@+id/return_btn"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="return"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:textColor="#DCE2E8"
        android:shadowRadius="4"
        android:textSize="16sp" />


    <Button
        android:id="@+id/playagain_btn"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="play"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:textColor="#DCE2E8"
        android:shadowRadius="4"
        android:textSize="18sp"
 />


</LinearLayout>