<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- כשכפתור הרדיו נבחר - תופיע הביצה -->
    <item android:drawable="@drawable/checked_svg" android:state_checked="true" />

    <!-- כשכפתור הרדיו לא נבחר - יופיע העיגול הריק/ביצה ריקה -->
    <item android:drawable="@drawable/unchecked_svg" android:state_checked="false" />
</selector>

