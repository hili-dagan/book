<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/blue_down" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item android:bottom="5dp" android:right="1dp" android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/blue_up" />
            <corners android:radius="12dp" />
            <padding
                android:top="0dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>